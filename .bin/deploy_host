#!/bin/bash
# Deploy AWS services for hosted storage (takes env arg -- dev|prod)
set -e
cd "$(dirname "$(dirname "$0")")"


# Note deploy env
env=${1:-dev}
echo "Deploying to $env environment"


# Build cloudformation template
node_modules/.bin/ts-node host/template_builder.ts


# Build host lambdas
.bin/build_host


# Load in env vars for deployment
source deploy_host_${env}.env
# Prompt for secret unless credentials already provided (e.g. via SSO session or AWS_PROFILE)
if [[ -z "$AWS_SECRET_ACCESS_KEY" && -z "$AWS_PROFILE" ]]; then
    read -s -p "AWS_SECRET_ACCESS_KEY: "
    export AWS_SECRET_ACCESS_KEY="$REPLY"
    echo  # Password input doesn't look like it worked otherwise (as silenced)
fi
echo "Deploying..."


# Deploy services
cd host
sam deploy --no-fail-on-empty-changeset --config-file template_input.toml --config-env deployed_${env}


# Map Cognito username to a principal tag (used by user role's IAM policy)
# NOTE SetPrincipalTagAttributeMap not supported by CloudFormation yet
# TODO Waiting on https://github.com/aws-cloudformation/cloudformation-coverage-roadmap/issues/779
read stack_name region < <(python3 -c "import tomllib
params = tomllib.load(open('template_input.toml', 'rb'))['deployed_${env}']['deploy']['parameters']
print(params['stack_name'], params['region'])")
stack_resource(){
    aws cloudformation describe-stack-resource --region "$region" --stack-name "$stack_name" \
        --logical-resource-id "$1" --query StackResourceDetail.PhysicalResourceId --output text
}
aws cognito-identity set-principal-tag-attribute-map --region "$region" \
    --identity-pool-id "$(stack_resource IdentityPool)" \
    --identity-provider-name "cognito-idp.$region.amazonaws.com/$(stack_resource UserPool)" \
    --no-use-defaults --principal-tags username=cognito:username > /dev/null
echo "Mapped Cognito username to principal tag"
